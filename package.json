{
  "name": "platesolve-review",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline plate-solve candidate review workbench (JSON/CSV only, no FITS, no network catalogs)",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest",
    "gen:fixtures": "node tools/gen-fixtures.ts",
    "server": "node server/index.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
